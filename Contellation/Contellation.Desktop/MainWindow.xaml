<Window x:Class="Contellation.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Contellation.Desktop"
        xmlns:ui="clr-namespace:Contellation.Custom.Controls;assembly=Contellation.Custom"
        xmlns:dag="clr-namespace:Contellation.Custom.Controls.Dragablz.Dockablz;assembly=Contellation.Custom"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <dag:Layout Partition="Test">

        <ui:TabablzControl Margin="8" ConsolidateOrphanedItems="True">
            <ui:TabablzControl.InterTabController>
                <ui:InterTabController Partition="Test" />
            </ui:TabablzControl.InterTabController>
            <TabItem Header="Tab 1" IsSelected="True">
                <TextBlock Text="Content of Tab 1" Margin="10"/>
            </TabItem>
            <TabItem Header="Tab 2">
                <TextBlock Text="Content of Tab 2" Margin="10"/>
            </TabItem>
        </ui:TabablzControl>
    </dag:Layout>
