<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Contellation.Custom.Controls"
                    xmlns:conv="clr-namespace:Contellation.Custom.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Contellation.Custom;component/Buttons/Normal/Button.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Contellation.Custom;component/Boxs/Text/TextBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Contellation.Custom;component/Generic/Style.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Style cho nút Reveal Password -->
    <Style x:Key="RevealPasswordButtonStyle" TargetType="{x:Type controls:Button}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Button}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="14">
                        <TextBlock Text="{Binding IsPasswordRevealed, RelativeSource={RelativeSource AncestorType=controls:PasswordBox}, 
                                                  Converter={StaticResource RevealIconConverter}}"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Col_A6A6A6}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style chính cho PasswordBox -->
    <Style x:Key="DefaultUiPasswordBoxStyle" TargetType="{x:Type controls:PasswordBox}" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Padding" Value="12,8,8,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="controls:Element.IconPlacement" Value="Left" />
        <Setter Property="ClearButtonEnabled" Value="True" />
        <Setter Property="RevealButtonEnabled" Value="True" />
        <Setter Property="controls:Element.CornerRadius" Value="4" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PasswordBox}">
                    <Border x:Name="ContentBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(controls:Element.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                            SnapsToDevicePixels="True">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Icon bên trái -->
                            <ContentPresenter x:Name="IconPresenter" Grid.Column="0"
                                              Margin="12,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{Binding Path=(controls:Element.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                              Visibility="{Binding Path=(controls:Element.Icon), RelativeSource={RelativeSource TemplatedParent}, 
                                                                   Converter={StaticResource NullToCollapsedConverter}}" />

                            <!-- Password Content -->
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False" />

                            <!-- Clear Button -->
                            <controls:Button x:Name="ClearButton" Grid.Column="2"
                                    Style="{StaticResource ClearButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding ShowClearButton, RelativeSource={RelativeSource TemplatedParent}, 
                                                         Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Command="{Binding Path=TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    CommandParameter="clear"/>
                            
                            <!-- Reveal Button -->
                            <controls:Button x:Name="RevealButton" Grid.Column="3"
                                    Style="{StaticResource RevealPasswordButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,5,0"
                                    Visibility="{Binding RevealButtonEnabled, RelativeSource={RelativeSource TemplatedParent}, 
                                                         Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Command="{x:Static controls:PasswordBox.ToggleRevealCommand}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Focus -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="2" />
                        </Trigger>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource MouseOverBorderBrush}" />
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Áp dụng style mặc định -->
    <Style BasedOn="{StaticResource DefaultUiPasswordBoxStyle}" TargetType="{x:Type controls:PasswordBox}" />
    
</ResourceDictionary>
