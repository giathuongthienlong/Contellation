<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Contellation.Custom.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Contellation.Custom;component/Boxs/Text/TextBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Contellation.Custom;component/Generic/Style.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="DefaultCurrencyBoxStyle" TargetType="{x:Type controls:CurrencyBox}" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,8,12,8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="IconPlacement" Value="Left" />
        <Setter Property="ClearButtonEnabled" Value="True" />
        <Setter Property="controls:Element.CornerRadius" Value="4" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CurrencyBox}">
                    <Border x:Name="ContentBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(controls:Element.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                            SnapsToDevicePixels="True">

                        <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon (ví dụ: ₫, $...) -->
                            <ContentPresenter x:Name="IconPresenter" Grid.Column="0"
                                              Margin="12,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{Binding Path=(controls:Element.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                              TextElement.FontFamily="{Binding Path=(controls:Element.FontFamilyIcon), RelativeSource={RelativeSource TemplatedParent}}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <!--Visibility="{Binding Path=(controls:Element.Icon), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}}" />-->

                            <!-- TextBox Content -->
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />

                            <!--Style="{StaticResource ClearButtonStyle}"-->
                            <!-- Clear Button -->
                            <Button x:Name="ClearButton" Grid.Column="2" 
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Content="✕"
                                    BorderThickness="0"
                                    Command="{Binding TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>

                        <!--Visibility="{Binding ShowClearButton, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"-->
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Focus State -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="2" />
                        </Trigger>

                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                        </Trigger>

                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource MouseOverBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Style mặc định áp dụng -->
    <Style BasedOn="{StaticResource DefaultCurrencyBoxStyle}" TargetType="{x:Type controls:CurrencyBox}" />
    
